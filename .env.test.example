# Variables para correr los tests (npm test) y el backend del test E2E (npm run start:test).
# Copiar como .env.test. Se carga DESPUÉS de .env: solo hace falta pisar lo que cambia.
#
# La base tiene que existir (vacía alcanza: las tablas las crea sync) y su nombre
# tiene que terminar en _test, si no vitest.config.js se niega a correr.
DB_NAME=CanchasTP_test
