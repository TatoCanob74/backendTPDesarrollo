# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=canchaya
DB_USER=root
DB_PASSWORD=

# Firma de los tokens de sesión
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# Credenciales de MercadoPago (Tus integraciones -> tu app -> Credenciales).
# Las de prueba y las productivas empiezan igual (APP_USR-): asegurate de cuál
# estás usando antes de pagar.
MP_ACCESS_TOKEN=

# URL del frontend a donde vuelve el usuario después de pagar.
#
# IMPORTANTE: MercadoPago solo acepta back_urls https. Con http (localhost
# incluido) responde 201 pero devuelve las back_urls VACÍAS, sin avisar, y el
# usuario se queda varado en la pantalla de MercadoPago sin forma de volver.
#
# Dejándolo en localhost la app igual funciona: el checkout se abre en otra
# pestaña y CanchaYa espera el resultado consultando el estado del pago.
#
# Para la vuelta automática real, exponé el frontend por https y poné esa URL:
#   npx cloudflared tunnel --url http://localhost:5173
#   FRONTEND_URL=https://algo-algo.trycloudflare.com
FRONTEND_URL=http://localhost:5173

# URL pública del backend, para que MercadoPago pueda llamar al webhook.
# En localhost no sirve (MercadoPago no puede alcanzarlo) y se ignora: la
# confirmación queda a cargo de la consulta de estado al volver del checkout.
# BACKEND_URL=https://algo-algo.trycloudflare.com
